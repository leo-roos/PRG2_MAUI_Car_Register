<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG_MAUI_Car_Register.View.MainPage">

    <ScrollView>
        <Grid Padding="20" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10">
            <Label Grid.Row="0" Text="Välkommen till Biluthyrningens App!" Style="{StaticResource SubHeadline}" />

            <Image Grid.Row="1" Source="car.jpg" Aspect="AspectFit" HeightRequest="150" Margin="0,0,0,20"/>

            <Label Grid.Row="2" Text="Vill du registrera ett fordon?" FontAttributes="Bold" />
            <Grid Grid.Row="3" ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <Button Text="Alla" Command="{Binding ViewFilterCommand}" CommandParameter="all" />
                <Button Grid.Column="0" Text="Bil" Command="{Binding ViewFilterCommand}" CommandParameter="car" />
                <Button Grid.Column="1" Text="Lastbil" Command="{Binding ViewFilterCommand}" CommandParameter="truck" />
                <Button Grid.Column="2" Text="MC" Command="{Binding ViewFilterCommand}" CommandParameter="mc" />
            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>
