<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG_MAUI_Car_Register.View.RegisterNewTruckPage"
             Title="RegisterNewTruckPage">
    <ScrollView>
        <Grid Padding="20" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"  RowSpacing="10">
            <Button HorizontalOptions="Start" Grid.Row="0" WidthRequest="100" Text="Gå Tillbaka" Command="{Binding GoBackCommand}" />

            <Label
                Grid.Row="1"
                Text="Välkommen till Lastbils-registreringen!"
                Style="{StaticResource SubHeadline}"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <Label Grid.Row="2" Text="Registreringsnummer" />
            <Entry Grid.Row="3" Text="{Binding RegistrationNumber}" Placeholder="ABC123" TextTransform="Uppercase" ReturnType="Next" />

            <Label Grid.Row="4" Text="Tillverkare" />
            <Entry Grid.Row="5" Text="{Binding Manufacturer}" Placeholder="Volvo" ReturnType="Next" />

            <Label Grid.Row="6" Text="Modell" />
            <Entry Grid.Row="7" Text="{Binding Model}" Placeholder="FH 500" ReturnType="Next" />

            <Label Grid.Row="8" Text="Årsmodell" />
            <Entry Grid.Row="9"  Text="{Binding YearModel}" Placeholder="2026" Keyboard="Numeric" ReturnType="Next" />

            <Label Grid.Row="10" Text="Lastkapacitet (kg)" />
            <Entry Grid.Row="11" Text="{Binding LoadCapacity}" Placeholder="15000" Keyboard="Numeric" ReturnType="Next" />

            <Button Grid.Row="12" Text="Registrera" Command="{Binding RegisterCommand}" Margin="0,0,0,20"/>

        </Grid>
    </ScrollView>
</ContentPage>